@startuml 02-use-case
left to right direction
skinparam packageStyle rectangle

actor "Resident" as res
actor "Community Organizer" as org

org --|> res

rectangle "Group Procurement Platform" {
  usecase "Register & Authenticate" as UC1
  usecase "Join Community via Invite Code" as UC2
  usecase "Browse Active Group Purchases" as UC3
  usecase "Submit / Modify / Cancel Request" as UC4
  usecase "Track Order & Collection Status" as UC5
  
  usecase "Create Residential Community" as UC6
  usecase "Create & Publish Group Purchase" as UC7
  usecase "Confirm Purchase Outcome & Update Status" as UC8
  usecase "Record Item Collection" as UC9
}

res --> UC1
res --> UC2
res --> UC3
res --> UC4
res --> UC5

org --> UC6
org --> UC7
org --> UC8
org --> UC9

@enduml